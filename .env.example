# Copy this file to .env.local and fill in the two real secrets.

# Anthropic API key for Claude event extraction. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Extraction model. Default is a good accuracy/cost balance.
# Options: claude-sonnet-4-6 (default) | claude-haiku-4-5 (cheapest) | claude-opus-4-8 (max accuracy)
EXTRACTION_MODEL=claude-sonnet-4-6

# Local database file (libSQL). No cloud account needed.
DATABASE_URL=file:./civicgrid.db

# Mapbox token for the browser map (must be NEXT_PUBLIC_). Get one at https://account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# Server-side token used only for geocoding. May be the SAME value as the public token for the MVP.
MAPBOX_SERVER_TOKEN=pk....
